# Mi renta — variables de entorno (ejemplo SIN secretos). Copia a .env y completa los valores reales fuera del repositorio.
# Formato ASP.NET Core: Seccion__Clave.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Base de datos PROPIA de Mi renta (no la del monolito LinaTask).
ConnectionStrings__MiRenta=Host=<host>;Port=5432;Database=mi_renta;Username=<usuario>;Password=<contraseña>;SSL Mode=Require
Database__MigrateOnStartup=true

# Firma de JWT propia (>= 32 bytes aleatorios; distinta de cualquier clave de LinaTask).
Jwt__SigningKey=<genera-con: openssl rand -base64 48>
Jwt__Issuer=mi-renta
Jwt__Audience=mi-renta-web

App__FrontendBaseUrl=https://<frontend>
# Correos que reciben rol Contador / Administrador de reglas al verificar su cuenta (opcional).
App__AllowedOrigins__0=https://<frontend>
App__UrlSigningKey=<otra-clave-aleatoria-de-48-bytes>
App__AccountantEmails__0=
App__RulesAdminEmails__0=

# Bucket R2 PRIVADO exclusivo de Mi renta (sin dominio público ni r2.dev).
Storage__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
Storage__BucketName=<bucket-privado-mi-renta>
Storage__AccessKeyId=<token-r2-limitado-al-bucket>
Storage__SecretAccessKey=<secreto-r2>
Storage__MaxFileBytes=15728640

# Correo: OBLIGATORIO en producción (verificación de cuenta y recuperación). En desarrollo se usa
# Email__PickupDirectory=.local-mail (archivos .eml locales); producción rechaza PickupDirectory.
Email__SmtpHost=
Email__SmtpPort=587
Email__Username=
Email__Password=
Email__From=Mi renta <no-reply@<dominio>>

# Pre-consulta DIAN: desactivada por defecto (endpoints observados, no documentados).
Dian__Enabled=false

# IA opcional (desactivada por defecto).
Ai__Provider=Disabled
Ai__ApiKey=

# Límites de solicitudes (opcional; no los subas en producción).
# RateLimiting__AuthPerMinute=10
# RateLimiting__DianPerMinute=5
# RateLimiting__UploadPer5Minutes=20
# RateLimiting__CalculatePerMinute=10
# RateLimiting__GlobalPerMinute=300

# Detalle de cada variable, dónde obtenerla y cómo generarla: docs/CONFIGURATION.md
